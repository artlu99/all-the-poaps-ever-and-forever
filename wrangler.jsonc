{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poaps",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Worker runs first so "/" and "/p/*" can inject OG/X meta with absolute
    // URLs; static assets fall through to the ASSETS binding in src/index.ts.
    // (wrangler 3 accepts only a boolean here; wrangler 4 also supports
    // glob arrays like ["/", "/p/*"] to keep assets on the edge path.)
    "run_worker_first": true
  },
  "ratelimits": [
    // per-IP rate limits (sliding window), enforced in src/index.ts.
    // API is strict (one collection per screen); artwork is generous
    // because swiping a whale collection lazy-loads dozens of images.
    // namespace_id is an arbitrary unique label required by the API;
    // limits live under "simple" (period must be 10 or 60 seconds).
    {
      "name": "RATE_LIMIT_API",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_ART",
      "namespace_id": "1002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "vars": {
    "ZIP_URL": "https://downloads.poaparchive.com/archive.zip",
    "RPC_URLS": "https://evm.stupidtech.net/v1/1,https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com,https://eth.drpc.org"
  }
  // Secrets (set once) — store is sqlite-rest when SQLITE_REST_URL is present,
  // else Turso when TURSO_DATABASE_URL is present:
  //   npx wrangler secret put SQLITE_REST_URL     e.g. https://sqlite-rest.your-vps.example
  //   npx wrangler secret put SQLITE_REST_TOKEN   bearer JWT accepted by that instance
  // Turso alternative:
  //   npx wrangler secret put TURSO_DATABASE_URL  e.g. libsql://poap-<slug>.turso.io
  //   npx wrangler secret put TURSO_AUTH_TOKEN
}
